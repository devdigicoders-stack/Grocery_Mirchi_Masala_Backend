PORT=5000
NODE_ENV=development
MONGO_URI=your_mongodb_connection_string_here
JWT_SECRET=your_jwt_secret_key
CLIENT_URL=http://localhost:5173

# Firebase Cloud Messaging (FCM) Push Notifications
# Generated from Firebase Console -> Project Settings -> Service Accounts -> Generate Private Key
FIREBASE_PROJECT_ID=tt-crm-f6a6c
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tt-crm-f6a6c.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json
